  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3fcf6555ce719334a8d6feef584321a7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Franco
        icon: {fileID: -4348277106678931353, guid: f324f54cb0abe2e4fba5a0eca21ed5be, type: 3}
      line: "Don\u2019t tell me a tiny little thing like you is planning to crawl
        into the depths\u2026"
    - character:
        name: Franco
        icon: {fileID: -4348277106678931353, guid: f324f54cb0abe2e4fba5a0eca21ed5be, type: 3}
      line: "If you\u2019re so eager to die, at least do it properly. Buy something
        from me. Just a little mutagen in return, tiny thing."
  promptInterface: {fileID: 1063161076}
  promptAnimationDuration: 0.15
  promptStartScale: 0.6
  promptEndScale: 1
  lookAtPlayer: 1
  invertFlipDirection: 0
